<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 11 (API 30) and older.
   See https://developer.android.com/guide/topics/data/autobackup

   Recordings are large (~5 MB per minute of audio). Auto Backup stops backing up the whole app
   once its data passes 25 MB, which would also lose settings and the saved vocal range, so
   recordings are left out. Settings, names, notes and stars (shared preferences) are backed up.
-->
<full-backup-content>
    <exclude domain="file" path="recordings/" />
</full-backup-content>
